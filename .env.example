# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Live workflow integrations. Keep LIVE_WORKFLOWS_ENABLED false until Resend, Google Calendar, and Gemini are configured.
LIVE_WORKFLOWS_ENABLED=false
WORKFLOW_WEBHOOK_SECRET=replace-with-a-random-32-plus-character-secret
# Resend transactional email API. The from address must use a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Fuzzie <notifications@example.com>"
# Google OAuth client for Google Calendar. Access is refreshed server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=https://localhost:3000/api/integrations/gmail/callback
# Retained environment variable name for the Google Calendar OAuth refresh token.
GMAIL_REFRESH_TOKEN=
# Google AI Studio API key used only by the server-side Gemini action.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Meta WhatsApp Cloud API credentials. Keep the access token server-side.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Approved positional utility template: Your task {{1}} is scheduled for {{2}}.
WHATSAPP_TASK_TEMPLATE_NAME=
WHATSAPP_TASK_TEMPLATE_LANGUAGE=en_US
